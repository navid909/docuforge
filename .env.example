# Environment Variables Template
# Copy this file to .env and fill in your values
# NEVER commit .env to version control

# ================================================
# Database Configuration
# ================================================
# PostgreSQL connection for the backend
DATABASE_URL=postgresql://${DB_USER}:${DB_PASSWORD}@postgres:5432/${DB_NAME}

# Database credentials (used by both docker-compose and applications)
DB_USER=docuforge
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD
DB_NAME=docuforge

# ================================================
# Redis Configuration
# ================================================
# Redis password (required for BullMQ and caching)
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD

# Redis connection URL (used internally by services)
REDIS_URL=redis://:${REDIS_PASSWORD}@redis:6379/0

# ================================================
# Authentication & Security
# ================================================
# Secret key for API key validation
API_KEY_SECRET=CHANGE_ME_API_KEY_SECRET_32_CHARS_MIN

# JWT configuration for user sessions
JWT_SECRET=CHANGE_ME_JWT_SECRET_32_CHARS_MIN
JWT_ALGORITHM=HS256

# CORS settings (comma-separated origins)
CORS_ORIGINS=https://your-domain.com,https://www.your-domain.com

# ================================================
# Frontend Environment (Next.js)
# ================================================
# Public API URL (exposed to browser)
NEXT_PUBLIC_API_URL=https://your-domain.com/api

# NextAuth configuration
NEXTAUTH_SECRET=CHANGE_ME_NEXTAUTH_SECRET_32_CHARS_MIN
NEXTAUTH_URL=https://your-domain.com

# ================================================
# File Upload & Processing
# ================================================
# Maximum upload size in bytes (10MB default)
MAX_UPLOAD_SIZE=10485760

# Enable/disable rate limiting
RATE_LIMIT_ENABLED=true

# File upload directory (internal)
FILE_UPLOAD_DIR=/app/tmp

# ================================================
# Nginx / SSL Configuration
# ================================================
# Your domain name (used for SSL certificates)
DOMAIN=your-domain.com

# Email for Let's Encrypt notifications
LETSENCRYPT_EMAIL=your-email@example.com

# ================================================
# Application Settings
# ================================================
# Environment (production, staging, development)
NODE_ENV=production

# Application URL
APP_URL=https://your-domain.com

# ================================================
# BullMQ Worker Configuration
# ================================================
# Queue name for background jobs
QUEUE_NAME=pdf-tasks

# Worker concurrency (jobs processed in parallel)
CONCURRENCY=5

# ================================================
# Feature Flags
# ================================================
# Enable premium features
ENABLE_PREMIUM=true

# Free tier daily limit
FREE_DAILY_LIMIT=3
